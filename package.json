{
  "name": "e-comm",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run start:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build:shared": "turbo run build --filter=@repo/shared",
    "db:start": "turbo run db:start --filter=users-service --filter=products-service",
    "db:stop": "turbo run db:stop --filter=users-service --filter=products-service",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.24"
  }
}
